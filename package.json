{
  "name": "zalo-native",
  "version": "0.2.6",
  "private": true,
  "description": "A compact desktop home for Zalo Web",
  "author": "Zalo Native",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "node test/smoke.cjs",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "test:popups": "node test/popups-smoke.cjs",
    "test:clipboard": "node test/clipboard-smoke.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "me.zalonative.desktop",
    "productName": "Zalo Native",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "extendInfo": {
        "NSCameraUsageDescription": "Dùng camera cho cuộc gọi Zalo.",
        "NSMicrophoneUsageDescription": "Dùng micro cho cuộc gọi Zalo.",
        "NSScreenCaptureUsageDescription": "Chụp vùng màn hình để chia sẻ trong Zalo."
      },
      "icon": "src/assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico"
    }
  }
}
