{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zalo Native Rust Lab",
  "version": "0.3.0",
  "identifier": "me.zalonative.rustlab",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "local-ui",
        "zalo-observer"
      ],
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' blob: data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "../../../src/assets/icon.icns",
      "../../../src/assets/icon.ico",
      "../../../src/assets/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
